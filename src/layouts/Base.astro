---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import StatusLine from '../components/StatusLine.astro';
import CommandPalette from '../components/CommandPalette.astro';
import profile from '../data/profile.json';

interface Props {
  title?: string;
  description?: string;
  room?: 'lab' | 'ops';
}
const {
  title = 'Matin Hassanloo · MH://lab: olfaction, signals & neural interfaces',
  description = 'Research notebook of Matin Hassanloo: reading notes, live tools and games on olfactory coding, neural signal processing and neural interfaces.',
  room = 'lab',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const person = {
  '@context': 'https://schema.org', '@type': 'Person', '@id': 'https://imatin.dev/#matin', name: profile.name, url: 'https://imatin.dev/', jobTitle: 'Neuroengineer',
  ...(profile.email ? { email: `mailto:${profile.email}` } : {}),
  sameAs: ['https://imatin.dev', `https://github.com/${profile.github}`, profile.scholar, profile.orcid, profile.telegram?.channel && `https://t.me/${profile.telegram.channel}`].filter(Boolean),
};
const ticker = ['olfactory coding', 'LFP', 'EEG', 'spike sorting', 'neural decoding', 'CNNs', 'neural interfaces', 'signal processing', 'telegram bots', 'security', 'astro', 'cloudflare'];
---
<!doctype html>
<html lang="en" data-room={room}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Matin Hassanloo" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="MH://lab notes" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#08090B" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav room={room} />
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="ticker mono" aria-hidden="true">
        <div class="ticker__track">
          {[0, 1].map(() => <span>{ticker.map((t) => <><b>{t}</b><i>·</i></>)}</span>)}
        </div>
      </div>
      <div class="frame footer__inner mono">
        <span>© {new Date().getFullYear()} Matin Hassanloo · <a href="https://imatin.dev">imatin.dev</a></span>
        <span><a href="/rss.xml">rss</a> · <a href="/ops/">ops</a> · built with Astro &amp; too much coffee · v0.4 · <kbd class="k">?</kbd></span>
      </div>
    </footer>
    <StatusLine />
    <CommandPalette />
    <div class="crt" aria-hidden="true"></div>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 8px; z-index: 80; padding: 10px 14px; background: var(--mint); color: var(--mint-ink); }
  .skip:focus { left: 8px; }
  .footer { border-top: 1px solid var(--line); }
  .ticker { overflow: hidden; border-bottom: 1px solid var(--line); font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); }
  .ticker__track { display: flex; width: max-content; animation: tick 40s linear infinite; }
  .ticker__track span { display: flex; gap: 22px; padding: 14px 11px; white-space: nowrap; }
  .ticker b { font-weight: 400; }
  .ticker i { font-style: normal; color: var(--mint); }
  @keyframes tick { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .ticker__track { animation: none; } }
  .footer__inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding: 24px var(--pad) 72px; font-size: 12px; color: var(--muted); }
  .k { font-size: 11px; padding: 0 6px; border: 1px solid var(--line-3); color: var(--text); }
</style>
