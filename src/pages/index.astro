---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import NoteGrid from '../components/NoteGrid.astro';
import LifSimulator from '../components/LifSimulator.astro';
import OdorDecoder from '../components/OdorDecoder.astro';
import Terminal from '../components/Terminal.astro';
import SpikeSorter from '../components/SpikeSorter.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);
const pubs = (await getCollection('publications')).sort((a, b) => a.data.order - b.data.order);
const kindColor: Record<string, string> = { patent: '#F5B454', paper: '#6EE7C8', preprint: '#9FB8FF', talk: '#F59EC0', thesis: '#A7B1BC' };

const tools = [
  { status: 'live', color: '#6EE7C8', title: 'Knowledge graph', body: 'Every note is a neuron, every shared concept a synapse. Watch spikes travel through a connectome of my reading.', icon: 'M5 6a2 2 0 1 0 0 .01M19 5a2 2 0 1 0 0 .01M12 19a2 2 0 1 0 0 .01M7 7l4 10M17 7l-4 10M7 6h10', href: '/graph/' },
  { status: 'in progress', color: '#F5B454', title: 'Odor decoder from LFP', body: 'A CNN that guesses which odor was presented from a few hundred milliseconds of bulb recordings. Demo with confusion matrix coming.', icon: 'M3 12h3l2-6 4 12 2-6h7' },
  { status: 'planned', color: '#8B96A3', title: 'Spectrogram explorer', body: 'Drop a CSV of EEG or LFP, pick a window and a filter band, and watch theta, beta and gamma light up. Nothing leaves your browser.', icon: 'M3 4h18v16H3zM7 16v-4M11 16V8M15 16v-6M19 16v-2' },
  { status: 'planned', color: '#8B96A3', title: 'Code snippets for neural data', body: 'Tiny, copy-pasteable Python recipes: bandpass, Hilbert phase, spike detection, epoching. The stuff I keep rewriting.', icon: 'M8 6 3 12l5 6M16 6l5 6-5 6M13.5 4l-3 16' },
];
const contacts = [
  { label: 'email', value: '[YOUR EMAIL]', href: 'mailto:you@example.com' },
  { label: 'scholar', value: '[GOOGLE SCHOLAR]', href: '#about' },
  { label: 'github', value: '[GITHUB]', href: '#about' },
  { label: 'orcid', value: '[ORCID]', href: '#about' },
  { label: 'rss', value: '/rss.xml', href: '/rss.xml' },
];
---
<Base>
  <Hero />

  <section id="notes" class="container section" style="padding-top: 96px">
    <div class="head-row">
      <div class="section-head" style="margin-bottom: 0">
        <span class="eyebrow">01 / reading notes</span>
        <h2 class="h2">Papers I read, in plain words.</h2>
      </div>
      <a class="mono all-link" href="/notes/">all notes →</a>
    </div>
    <NoteGrid notes={notes} />
  </section>

  <section id="tools" class="container section">
    <div class="section-head">
      <span class="eyebrow">02 / tools</span>
      <h2 class="h2">Small instruments for big signals.</h2>
      <p>Interactive things I build to see data, teach ideas, or check my own intuition. Everything runs in your browser.</p>
    </div>
    <LifSimulator />
    <div class="grid-cards" style="margin-top: 16px">
      {tools.map((t) => (
        <article class="card" style="position: relative">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke={t.color === '#8B96A3' ? '#6EE7C8' : t.color} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={t.icon}></path></svg>
          <span class="mono" style={`font-size: 12px; color: ${t.color}`}>{t.status}</span>
          <h3>{t.href ? <a class="stretched" href={t.href}>{t.title} →</a> : t.title}</h3>
          <p>{t.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="play" class="container section">
    <div class="section-head">
      <span class="eyebrow">03 / play</span>
      <h2 class="h2">Games for people who think in spikes.</h2>
      <p>Two small games about how brains and electrodes see the world. One is about reading the olfactory code, the other about cleaning up a messy recording.</p>
    </div>
    <div class="tabs mono" role="tablist" aria-label="Games">
      <button type="button" role="tab" id="tab-odor" aria-controls="panel-odor" aria-selected="true" data-tab="odor">Odor Decoder</button>
      <button type="button" role="tab" id="tab-sorter" aria-controls="panel-sorter" aria-selected="false" data-tab="sorter">Spike Sorter <span class="new">new</span></button>
    </div>
    <div role="tabpanel" id="panel-odor" aria-labelledby="tab-odor">
      <p class="game-blurb">Each odor lights up its own pattern of glomeruli. You get one noisy sniff. Decode it. Noise rises every level, and from level 4 the reference maps disappear.</p>
      <OdorDecoder />
    </div>
    <div role="tabpanel" id="panel-sorter" aria-labelledby="tab-sorter" hidden>
      <p class="game-blurb">Twenty noisy waveforms from one electrode, three neurons hiding in them. Sort them by shape, then see your clusters in feature space.</p>
      <SpikeSorter />
    </div>
  </section>

  <section id="terminal" class="container section">
    <div class="section-head">
      <span class="eyebrow">04 / terminal</span>
      <h2 class="h2">ssh guest@metin.lab</h2>
      <p>A tiny shell into the lab. Type <code class="mono" style="color: var(--mint)">help</code> to see what it knows. Some commands are hidden.</p>
    </div>
    <Terminal />
  </section>

  <section id="publications" class="container section">
    <div class="section-head">
      <span class="eyebrow">05 / publications</span>
      <h2 class="h2">Things with a DOI (or soon).</h2>
    </div>
    <ul class="pubs">
      {pubs.map((p) => (
        <li class="pub">
          <span class="mono pub__year">{p.data.year}</span>
          <div class="pub__main">
            {p.data.url ? <a class="pub__title" href={p.data.url}>{p.data.title}</a> : <span class="pub__title">{p.data.title}</span>}
            <span class="pub__venue">{p.data.venue}</span>
          </div>
          <span class="badge" style={`color: ${kindColor[p.data.kind]}; border-color: ${kindColor[p.data.kind]}44`}>{p.data.kind}</span>
        </li>
      ))}
    </ul>
  </section>

  <section id="about" class="container section" style="padding-bottom: 96px">
    <div class="about">
      <div class="about__text">
        <span class="eyebrow">06 / about</span>
        <h2 class="h2" style="font-size: clamp(28px, 3.4vw, 38px)">Engineer by training, neuroscientist by obsession.</h2>
        <p>I teach Object-Oriented Programming (Java) and C at Istanbul Medipol University. My research sits where engineering meets computational neuroscience: olfactory neural interfaces, neural signal processing, and deep learning on recordings from the brain.</p>
        <p>This site is my lab notebook in public. If something here sparks an idea, write to me.</p>
      </div>
      <div class="contact mono">
        <span class="muted" style="font-size: 12px">$ cat contact.txt</span>
        {contacts.map((c) => (
          <a href={c.href}><span class="muted">{c.label}</span><span>{c.value}</span></a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .stretched { color: var(--text); }
  .stretched::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .stretched:hover { color: var(--mint); }
  .tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
  .tabs button { min-height: 42px; padding: 0 16px; border-radius: 10px; border: 1px solid var(--line-3); background: transparent; color: var(--text-2); font-family: var(--font-mono); font-size: 13px; }
  .tabs button[aria-selected='true'] { background: var(--mint); border-color: var(--mint); color: var(--mint-ink); }
  .new { margin-left: 6px; padding: 1px 6px; border-radius: 5px; background: var(--amber); color: #1A1204; font-size: 10px; }
  .game-blurb { margin: 0 0 16px; color: var(--text-2); max-width: 720px; }
  .head-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 28px; }
  .all-link { font-size: 13px; padding: 10px 0; }
  .pubs { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-2); }
  .pub { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 24px; padding: 22px 0; border-bottom: 1px solid var(--line-2); }
  .pub__year { flex: 0 0 90px; font-size: 13px; color: var(--muted); }
  .pub__main { flex: 999 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .pub__title { font-family: var(--font-display); font-size: 19px; font-weight: 500; line-height: 1.3; color: var(--text); }
  a.pub__title:hover { color: var(--mint); }
  .pub__venue { font-size: 14px; color: var(--muted); }
  .about { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 40px; padding: clamp(28px, 4vw, 48px); border: 1px solid var(--line-2); border-radius: 20px; background: var(--surface); }
  .about__text { display: flex; flex-direction: column; gap: 16px; }
  .about__text p { margin: 0; color: var(--text-2); }
  .contact { display: flex; flex-direction: column; gap: 10px; font-size: 14px; }
  .contact a { display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 48px; padding: 0 16px; border: 1px solid var(--line-2); border-radius: 10px; background: var(--surface-2); }
  .contact a:hover { border-color: #2E3944; }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const select = (t: HTMLButtonElement) => {
    tabs.forEach((x) => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
    });
  };
  tabs.forEach((t, i) => {
    t.tabIndex = i === 0 ? 0 : -1;
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const n = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      select(n); n.focus();
    });
  });
  if (location.hash === '#sorter') select(tabs[1]);
</script>
