---
import Base from '../layouts/Base.astro';
---
<Base title="404 — signal lost · metin.lab">
  <section class="container lost">
    <p class="mono code">ERR 404 · no spikes detected</p>
    <svg viewBox="0 0 600 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 40H600" stroke="#6EE7C8" stroke-width="2" fill="none" vector-effect="non-scaling-stroke"></path></svg>
    <h1>This neuron went silent.</h1>
    <p>The page you were looking for isn't here. Maybe it was pruned.</p>
    <div class="row"><a class="btn btn-primary" href="/">Back to the lab</a><a class="btn" href="/notes/">Read the notes</a></div>
  </section>
</Base>

<style>
  .lost { max-width: 720px; padding-block: 120px; display: flex; flex-direction: column; gap: 20px; }
  .code { margin: 0; color: var(--pink); font-size: 13px; }
  svg { width: 100%; height: 60px; }
  h1 { margin: 0; font-family: var(--font-display); font-size: clamp(36px, 5vw, 56px); letter-spacing: -0.03em; line-height: 1.05; }
  p { margin: 0; color: var(--text-2); font-size: 18px; }
  .row { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
