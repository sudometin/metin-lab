---
interface Props { room?: 'lab' | 'ops' }
const { room = 'lab' } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/notes/', label: 'notes', n: '01' },
  { href: '/graph/', label: 'graph', n: '02' },
  { href: '/#instruments', label: 'tools', n: '03' },
  { href: '/#play', label: 'play', n: '04' },
  { href: '/ops/', label: 'ops', n: '05' },
  { href: '/now/', label: 'now', n: '06' },
];
---
<header class="nav">
  <nav aria-label="Main" class="nav__inner">
    <a href="/" class="logo" aria-label="MH lab home">
      <svg width="22" height="22" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="14" cy="14" r="4.5"></circle><path d="M14 9.5V3M9.8 12.2 4 8.5M18.2 12.2 24 8.5M10.5 17.2 5.5 23M17.5 17.2 22.5 23M14 18.5V25"></path></svg>
      <span class="mono"><span class="mint">MH://</span>{room === 'ops' ? 'ops' : 'lab'}</span><span class="block" aria-hidden="true"></span>
    </a>
    <div class="nav__links mono">
      {links.map((l) => (
        <a class:list={['nav__link', { 'is-on': path.startsWith(l.href.replace('/#', '/__')) || (l.href === '/ops/' && room === 'ops') }]} href={l.href}>
          <span class="n">{l.n}</span>{l.label}
        </a>
      ))}
    </div>
    <div class="nav__tools mono">
      <button type="button" class="kbtn" data-open-cmdk aria-label="Open command palette">nav <kbd>⌘K</kbd></button>
      <a class="home" href="https://imatin.dev" aria-label="imatin.dev home">~/</a>
    </div>
  </nav>
</header>

<style>
  .nav { position: sticky; top: 0; z-index: 30; background: rgba(8,9,11,.88); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .nav__inner { max-width: var(--max); margin: 0 auto; border-inline: 1px solid var(--line); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 28px; padding: 12px var(--pad); }
  .logo { display: flex; align-items: center; gap: 10px; color: var(--mint); font-size: 14px; font-weight: 500; letter-spacing: .1em; }
  .logo .mono { color: var(--text); text-transform: uppercase; }
  .block { width: 8px; height: 15px; background: var(--mint); animation: b 1.1s steps(1) infinite; }
  @keyframes b { 50% { opacity: 0; } }
  .nav__links { display: flex; flex-wrap: wrap; gap: 2px 22px; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; }
  .nav__link { color: var(--muted); padding: 10px 0; border-bottom: 1px solid transparent; }
  .nav__link .n { color: var(--faint); margin-right: 6px; }
  .nav__link:hover, .nav__link.is-on { color: var(--text); border-bottom-color: var(--mint); }
  .nav__link:hover .n { color: var(--mint); }
  .nav__tools { display: flex; gap: 8px; }
  .kbtn, .home { min-height: 34px; padding: 0 10px; border: 1px solid var(--line-3); background: transparent; color: var(--muted); font-family: var(--font-mono); font-size: 12px; display: inline-flex; align-items: center; gap: 6px; }
  .kbtn kbd { padding: 0 5px; background: var(--mint); color: var(--mint-ink); }
  .kbtn:hover, .home:hover { color: var(--text); border-color: var(--mint); }
  @media (max-width: 820px) { .nav__tools { display: none; } }
  @media (max-width: 640px) { .nav__links { gap: 2px 14px; font-size: 11px; } .nav__link .n { display: none; } }
  @media (prefers-reduced-motion: reduce) { .block { animation: none; } }
</style>

<script>
  document.querySelector('[data-open-cmdk]')?.addEventListener('click', () => {
    window.dispatchEvent(new KeyboardEvent('keydown', { key: 'k', ctrlKey: true }));
  });
</script>
